# === Database ===
# Production target: MySQL/MariaDB (create this via "MySQL Databases" in
# cPanel — cPanel-created DBs are usually prefixed with your cPanel username,
# e.g. cpaneluser_sakkab). Format:
# mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
DATABASE_URL="mysql://sakkab_user:change-me@localhost:3306/sakkab_doors"

# Local dev without a MySQL server? Temporarily set:
#   provider = "sqlite"   in prisma/schema.prisma, and
#   DATABASE_URL="file:./dev.db"   here.

# === Admin auth ===
# Random long string used to sign admin session cookies (openssl rand -hex 32)
ADMIN_SESSION_SECRET="change-this-to-a-long-random-string"

# Optional: choose the first admin account's credentials yourself. Leave
# unset and `npm run db:seed` will generate a strong random password and
# print it once to the terminal — either way, change it from /admin after
# your first login.
# DEFAULT_ADMIN_USERNAME="admin"
# DEFAULT_ADMIN_PASSWORD=""

# === Outgoing order emails ===
# SMTP credentials used to auto-send new orders to the store's inbox.
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="orders@sakkabdoors.ae"
SMTP_PASS="your-smtp-password"

# Where every new order/inquiry is auto-forwarded to
ORDER_NOTIFY_EMAIL="FAX@SAKKABDOORS.AE"
ORDER_FROM_EMAIL="orders@sakkabdoors.ae"

# === WhatsApp click-to-chat ===
# International format, digits only, no "+" or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER="971508838615"

# === AI assistant (storefront chat widget) ===
# Leave AI_PROVIDER="none" to keep the chat widget hidden/disabled until
# you're ready. Set to "anthropic" or "openai" and fill in the matching key
# to switch it on — the assistant only answers from the Knowledge Base you
# manage in /admin/ai plus the live product catalog.
AI_PROVIDER="none"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="claude-3-5-haiku-20241022"
NEXT_PUBLIC_AI_CHAT_ENABLED="false"

# === Site ===
NEXT_PUBLIC_SITE_NAME="Sakkab Doors"
NEXT_PUBLIC_SITE_URL="https://sakkabdoors.ae"

// Sakkab Doors – Prisma schema
// Production target: MySQL/MariaDB (standard on cPanel shared hosting).
// For local development without a MySQL server, you can temporarily switch
// provider to "sqlite" and DATABASE_URL to "file:./dev.db" — see README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Material {
  WPC
  UPVC
  ALUMINUM
  STEEL
}

enum OrderStatus {
  NEW
  CONTACTED
  CONFIRMED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  EMPLOYEE
}

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameAr        String
  nameEn        String
  // Marketing copy for the homepage "spotlight" section (WPC / UPVC / Aluminum
  // doors blocks). Optional so extra categories can be added later without copy.
  taglineAr     String?
  taglineEn     String?
  descriptionAr String?  @db.Text
  descriptionEn String?  @db.Text
  heroImage     String?
  products      Product[]
  createdAt     DateTime  @default(now())
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameAr        String
  nameEn        String
  descriptionAr String         @db.Text
  descriptionEn String         @db.Text
  material      Material       @default(WPC)
  price         Float
  currency      String         @default("AED")
  inStock       Boolean        @default(true)
  featured      Boolean        @default(false)
  category      Category       @relation(fields: [categoryId], references: [id])
  categoryId    String
  images        ProductImage[]
  orderItems    OrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

// A single order can quote one product (added from a product detail page)
// or several at once (submitted from the cart) — either way it's one Order
// with one-or-more OrderItem rows. A general inquiry (contact page, no
// product attached) has zero items.
model Order {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  email        String?
  city         String?
  message      String?     @db.Text
  status       OrderStatus @default(NEW)
  emailedOk    Boolean     @default(false)
  items        OrderItem[]
  createdAt    DateTime    @default(now())

  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int      @default(1)

  @@index([orderId])
  @@index([productId])
}

// --- Real estate (separate from the door Product catalog — no material or
// door Category, has a region instead) ------------------------------------
model Property {
  id            String          @id @default(cuid())
  slug          String          @unique
  titleAr       String
  titleEn       String
  descriptionAr String          @db.Text
  descriptionEn String          @db.Text
  price         Float
  currency      String          @default("AED")
  regionAr      String
  regionEn      String
  images        PropertyImage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([regionAr])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  alt        String   @default("")
  position   Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  @@index([propertyId])
}

// --- Careers / job openings -----------------------------------------------
model Job {
  id            String   @id @default(cuid())
  titleAr       String
  titleEn       String
  locationAr    String
  locationEn    String
  descriptionAr String
  descriptionEn String
  createdAt     DateTime @default(now())
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         AdminRole @default(EMPLOYEE)
  createdAt    DateTime  @default(now())
}

// --- AI assistant ("train it") -------------------------------------------
// Everything the storefront chat widget is allowed to say is grounded in
// these entries (plus the live product catalog) — the admin "trains" the
// assistant by adding/editing entries here, not by fine-tuning a model.
model KnowledgeEntry {
  id        String   @id @default(cuid())
  category  String   @default("general") // general | faq | policy | product
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Every visitor question + the assistant's answer, so an admin can review
// what people actually ask and turn gaps into new KnowledgeEntry rows.
model ChatLog {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  locale    String   @default("ar")
  createdAt DateTime @default(now())
}

// --- Site content CMS -----------------------------------------------------
// One JSON row per homepage/footer section (key: "hero" | "stats" |
// "services" | "quality" | "cta" | "footer") so the admin can edit copy,
// numbers, and icon choices without a code change or schema migration —
// value shape is validated in app code (lib/siteContent.ts), not the DB.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
